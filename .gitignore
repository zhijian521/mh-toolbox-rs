# 依赖与产物
node_modules/
dist/

# Rust 构建产物
target/
src-tauri/target/
# tauri-build 生成的权限 schema（每次编译自动重建）
src-tauri/gen/schemas/
# 移动端图标：本项目只出 Windows，tauri icon 每次都会重新铺一遍
src-tauri/icons/android/
src-tauri/icons/ios/

# 临时探针、截图脚本产物（用完即删，不入库）
.runtime/

# 地图素材的加工现场：原始整窗截图 + 切图产物 + 核对页。
# 产品用的是 public/game/maps/ 下的 webp 与 maps.json（共 1.4MB，入库）。
# 2026-11-01 已把这份 47MB 原料删掉（不再需要重切图）；规则留着，
# 下次重新截图切图时仍然不该进版本库。
map/

# 项目记忆与工具上下文
.workbuddy/

# 编辑器与系统
.DS_Store
Thumbs.db
*.log

# 图标脚本的中间产物（4 方案 × 8 档，可随时重跑）
scripts/icon/out/

# Python 编译缓存：`tools/game-icons/` 下那几个独立脚本跑一次 `py_compile` 就留一份，
# 与仓库内容无关，留在 `git status` 里只会干扰「这次到底改了什么」的判读。
__pycache__/
*.pyc
