{
    "name": "mh-toolbox-rs",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "梦幻养老助手 · Rust + Tauri 版界面",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "desktop": "tauri dev",
        "desktop:build": "tauri build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:commits": "git log -20 --no-merges --format=%s | node scripts/check-commits.mjs",
        "check:version": "node scripts/check-version.mjs",
        "typecheck": "vue-tsc --noEmit",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:version"
    },
    "engines": {
        "node": ">=22.0.0 <23",
        "npm": ">=10"
    },
    "packageManager": "npm@10.9.7",
    "dependencies": {
        "@tabler/icons-vue": "^3.50.0",
        "@tauri-apps/api": "^2",
        "vue": "^3.5.13",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2",
        "@vitejs/plugin-vue": "^5.2.1",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^6.0.7",
        "vue-tsc": "^2.2.0"
    }
}
